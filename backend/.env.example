# PostgreSQL (default). Database name must exist: createdb safari
PTSMS_DB_NAME=safari
PTSMS_DB_USER=postgres
PTSMS_DB_PASSWORD=
PTSMS_DB_HOST=127.0.0.1
PTSMS_DB_PORT=5432

# Optional: PTSMS_DB_ENGINE=sqlite for local SQLite instead

PTSMS_SECRET_KEY=change-me-in-production
PTSMS_DEBUG=1

# First super admin (bootstrap_admin), only if none exists yet
# PTSMS_ADMIN_EMAIL=admin@paultours.local
# PTSMS_ADMIN_PASSWORD=PaulTours#2026
