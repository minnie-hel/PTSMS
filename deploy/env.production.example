# Production example — copy to /srv/ptsms/backend/.env and fill in secrets.
# Never commit the live file.

PTSMS_DB_NAME=safari
PTSMS_DB_USER=ptsms
PTSMS_DB_PASSWORD=change-me
PTSMS_DB_HOST=127.0.0.1
PTSMS_DB_PORT=5432

PTSMS_SECRET_KEY=generate-a-long-random-string
PTSMS_DEBUG=0
PTSMS_ALLOWED_HOSTS=desk.example.com
PTSMS_CORS_ORIGINS=https://desk.example.com
PTSMS_CSRF_TRUSTED_ORIGINS=https://desk.example.com
PTSMS_HTTPS=1
PTSMS_SSL_REDIRECT=0
PTSMS_STATIC_ROOT=/srv/ptsms/backend/staticfiles
PTSMS_MEDIA_ROOT=/srv/ptsms/backend/media

# PTSMS_ADMIN_EMAIL=admin@paultours.local
# PTSMS_ADMIN_PASSWORD=set-once-then-change
